MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=tuoguan
MYSQL_USER=tuoguan
MYSQL_PASSWORD=tuoguan_change_me

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_change_me

# 后端生成头像等文件的访问链接（预签名 URL）时使用的公网地址。
# 必须是浏览器/家长手机能直接访问到的地址，不能用容器内部地址 http://minio:9000。
# 部署前需要单独准备一个子域名反代到 MinIO，原因见 deploy/nginx/files.conf.example。
# 例如：MINIO_PUBLIC_ENDPOINT=https://files.example.com
MINIO_PUBLIC_ENDPOINT=https://files.example.com

JWT_SECRET=change_me_to_a_random_32_byte_or_longer_secret

# 前端 Docker 构建时用的 npm 源。国内服务器直连 registry.npmjs.org 经常不稳定，
# 换成国内镜像下载更快更稳（构建脚本本身已经能自动重试装不全的情况，见 DEPLOY.md
# 里 "sh: tsc: not found" 那条说明）：
# NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
